		{
			"name": "Get available years for the selected courses",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Response status code is 200\", function () {",
							"  pm.response.to.have.status(200);",
							"});",
							"",
							"",
							"pm.test(\"Response has the required field - available_years\", function () {",
							"    const responseData = pm.response.json();",
							"    ",
							"    pm.expect(responseData).to.be.an('object');",
							"    pm.expect(responseData.available_years).to.exist;",
							"});",
							"",
							"",
							"pm.test(\"Available years is an array\", function () {",
							"  const responseData = pm.response.json();",
							"  ",
							"  pm.expect(responseData.available_years).to.be.an('array');",
							"});",
							"",
							"",
							"pm.test(\"Available years array is not empty\", function () {",
							"    const responseData = pm.response.json();",
							"    ",
							"    pm.expect(responseData).to.be.an('object');",
							"    pm.expect(responseData.available_years).to.exist.and.to.have.lengthOf.at.least(1, \"Available years array should not be empty\");",
							"});",
							"",
							"",
							"pm.test(\"Available years array contains only positive integers\", function () {",
							"    const responseData = pm.response.json();",
							"    ",
							"    pm.expect(responseData).to.be.an('object');",
							"    pm.expect(responseData.available_years).to.be.an('array');",
							"    ",
							"    responseData.available_years.forEach(function(year) {",
							"        pm.expect(year).to.be.a('number');",
							"        pm.expect(year).to.be.above(0);",
							"    });",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
